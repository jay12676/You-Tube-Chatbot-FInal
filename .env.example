# Copy this file to .env and fill in your API keys

# --- Required API keys ---
DEEPGRAM_API_KEY=your_deepgram_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# --- Optional: override defaults ---

# Backend URL used by the Streamlit frontend (create frontend/.env with this)
# BACKEND_URL=http://localhost:8011

# Groq model for summarization and chat
# GROQ_MODEL=llama-3.3-70b-versatile

# Deepgram model for speech-to-text
# DEEPGRAM_MODEL=nova-2

# Audio chunk size in seconds for parallel Deepgram transcription
# DEEPGRAM_CHUNK_DURATION_SEC=300
