# ── backend/.env ────────────────────────────────────────────────────────────
# Copy to backend/.env and fill in your API keys

# Required API keys
DEEPGRAM_API_KEY=your_deepgram_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Gemini vision (visual understanding). Get a free key at https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# Optional overrides (defaults shown)
# GROQ_MODEL=llama-3.3-70b-versatile
# DEEPGRAM_MODEL=nova-2
# DEEPGRAM_CHUNK_DURATION_SEC=300
# GEMINI_VISION_MODEL=gemini-2.0-flash


# ── frontend/.env ────────────────────────────────────────────────────────────
# Copy to frontend/.env — only needed if backend runs on a different host/port

# BACKEND_URL=http://localhost:8011
